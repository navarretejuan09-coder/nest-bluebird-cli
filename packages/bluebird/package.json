{
  "name": "bluebird-nestjs",
  "license": "UNLICENSED",
  "version": "0.1.34",
  "description": "Diagnose and improve NestJS project health",
  "type": "module",
  "bin": {
    "bluebird": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./eslint-plugin": {
      "import": "./dist/eslint-plugin.js",
      "types": "./dist/eslint-plugin.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/endpointclosing/bluebird.git",
    "directory": "packages/bluebird"
  },
  "homepage": "https://github.com/endpointclosing/bluebird#readme",
  "bugs": {
    "url": "https://github.com/endpointclosing/bluebird/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:coverage:readme": "vitest run --coverage && node scripts/update-readme-coverage.mjs",
    "lint": "eslint src/ tests/",
    "lint:fix": "eslint src/ tests/ --fix",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsdown && cp ../../README.md ."
  },
  "keywords": [
    "nestjs",
    "doctor",
    "lint",
    "diagnostics",
    "health-check",
    "code-quality",
    "eslint-plugin",
    "static-analysis"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "chokidar": "^5.0.0",
    "commander": "^13.1.0",
    "glob": "^13.0.6",
    "knip": "^5.44.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "typescript": "~5.7.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0 <6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.0",
    "@types/prompts": "^2.4.9",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.0.2",
    "tsdown": "^0.20.3",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.56.1",
    "vitest": "^3.0.0"
  }
}
